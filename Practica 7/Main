import java.io.*;
import java.util.*;
import java.time.*;
import java.time.temporal.ChronoUnit;


/*
 * =====================================================
 * TIPOS PROPORCIONADOS POR HACKERRANK
 * =====================================================
 */

enum TipoReembolso {
    ALIMENTOS,
    TRANSPORTE,
    HOSPEDAJE
}


enum ResultadoValidacion {
    APROBADO,
    SIN_COMPROBANTE,
    FUERA_DE_PERIODO,
    EXCEDE_LIMITE,
    REQUIERE_AUTORIZACION
}


/*
 * =====================================================
 * DTO DE ENTRADA
 * =====================================================
 */

final class ReembolsoInputDTO {

    private final TipoReembolso tipo;
    private final String folio;
    private final String empleado;
    private final double monto;
    private final LocalDate fechaGasto;
    private final boolean tieneComprobante;
    private final boolean autorizadoGerente;
    private final LocalDate fechaEvaluacion;


    public ReembolsoInputDTO(
            TipoReembolso tipo,
            String folio,
            String empleado,
            double monto,
            LocalDate fechaGasto,
            boolean tieneComprobante,
            boolean autorizadoGerente,
            LocalDate fechaEvaluacion) {

        this.tipo = tipo;
        this.folio = folio;
        this.empleado = empleado;
        this.monto = monto;
        this.fechaGasto = fechaGasto;
        this.tieneComprobante = tieneComprobante;
        this.autorizadoGerente = autorizadoGerente;
        this.fechaEvaluacion = fechaEvaluacion;
    }


    public TipoReembolso getTipo() {
        return tipo;
    }

    public String getFolio() {
        return folio;
    }

    public String getEmpleado() {
        return empleado;
    }

    public double getMonto() {
        return monto;
    }

    public LocalDate getFechaGasto() {
        return fechaGasto;
    }

    public boolean tieneComprobante() {
        return tieneComprobante;
    }

    public boolean estaAutorizadoGerente() {
        return autorizadoGerente;
    }

    public LocalDate getFechaEvaluacion() {
        return fechaEvaluacion;
    }
}


/*
 * =====================================================
 * DTO DE SALIDA
 * =====================================================
 */

final class ReembolsoOutputDTO {

    private final String folio;
    private final TipoReembolso tipo;
    private final ResultadoValidacion resultado;


    public ReembolsoOutputDTO(
            String folio,
            TipoReembolso tipo,
            ResultadoValidacion resultado) {

        this.folio = folio;
        this.tipo = tipo;
        this.resultado = resultado;
    }


    public String getFolio() {
        return folio;
    }

    public TipoReembolso getTipo() {
        return tipo;
    }

    public ResultadoValidacion getResultado() {
        return resultado;
    }
}


/* =====================================================
   1 y 2. JERARQUIA DE REEMBOLSOS
   ===================================================== */

abstract class Reembolso {

    private final String folio;
    private final String empleado;
    private final double monto;
    private final LocalDate fechaGasto;
    private final boolean tieneComprobante;
    private final boolean autorizadoGerente;


    /* Constructor completo */
    protected Reembolso(
            String folio,
            String empleado,
            double monto,
            LocalDate fechaGasto,
            boolean tieneComprobante,
            boolean autorizadoGerente) {

        this.folio = folio;
        this.empleado = empleado;
        this.monto = monto;
        this.fechaGasto = fechaGasto;
        this.tieneComprobante = tieneComprobante;
        this.autorizadoGerente = autorizadoGerente;
    }


    /* Constructor sobrecargado: sin autorizacion gerencial */
    protected Reembolso(
            String folio,
            String empleado,
            double monto,
            LocalDate fechaGasto,
            boolean tieneComprobante) {

        this(folio, empleado, monto,
                fechaGasto, tieneComprobante, false);
    }


    public String getFolio() {
        return folio;
    }

    public String getEmpleado() {
        return empleado;
    }

    public double getMonto() {
        return monto;
    }

    public LocalDate getFechaGasto() {
        return fechaGasto;
    }

    public boolean tieneComprobante() {
        return tieneComprobante;
    }

    public boolean estaAutorizadoGerente() {
        return autorizadoGerente;
    }

    public abstract double getLimitePermitido();
}


class ReembolsoAlimentos extends Reembolso {

    public ReembolsoAlimentos(
            String folio,
            String empleado,
            double monto,
            LocalDate fechaGasto,
            boolean tieneComprobante,
            boolean autorizadoGerente) {

        super(folio, empleado, monto,
                fechaGasto, tieneComprobante, autorizadoGerente);
    }

    @Override
    public double getLimitePermitido() {
        return 1000;
    }
}


class ReembolsoTransporte extends Reembolso {

    public ReembolsoTransporte(
            String folio,
            String empleado,
            double monto,
            LocalDate fechaGasto,
            boolean tieneComprobante,
            boolean autorizadoGerente) {

        super(folio, empleado, monto,
                fechaGasto, tieneComprobante, autorizadoGerente);
    }

    @Override
    public double getLimitePermitido() {
        return 1500;
    }
}


class ReembolsoHospedaje extends Reembolso {

    public ReembolsoHospedaje(
            String folio,
            String empleado,
            double monto,
            LocalDate fechaGasto,
            boolean tieneComprobante,
            boolean autorizadoGerente) {

        super(folio, empleado, monto,
                fechaGasto, tieneComprobante, autorizadoGerente);
    }

    @Override
    public double getLimitePermitido() {
        return 4000;
    }
}


/* =====================================================
   3. FACTORY METHOD
   ===================================================== */

abstract class RegistroReembolso {

    /* Factory Method */
    public abstract Reembolso crearReembolso(
            ReembolsoInputDTO input);
}


class RegistroAlimentos extends RegistroReembolso {

    @Override
    public Reembolso crearReembolso(ReembolsoInputDTO input) {
        return new ReembolsoAlimentos(
                input.getFolio(),
                input.getEmpleado(),
                input.getMonto(),
                input.getFechaGasto(),
                input.tieneComprobante(),
                input.estaAutorizadoGerente());
    }
}


class RegistroTransporte extends RegistroReembolso {

    @Override
    public Reembolso crearReembolso(ReembolsoInputDTO input) {
        return new ReembolsoTransporte(
                input.getFolio(),
                input.getEmpleado(),
                input.getMonto(),
                input.getFechaGasto(),
                input.tieneComprobante(),
                input.estaAutorizadoGerente());
    }
}


class RegistroHospedaje extends RegistroReembolso {

    @Override
    public Reembolso crearReembolso(ReembolsoInputDTO input) {
        return new ReembolsoHospedaje(
                input.getFolio(),
                input.getEmpleado(),
                input.getMonto(),
                input.getFechaGasto(),
                input.tieneComprobante(),
                input.estaAutorizadoGerente());
    }
}


/* =====================================================
   4 y 5. CHAIN OF RESPONSIBILITY
   ===================================================== */

abstract class ValidadorReembolso {

    private ValidadorReembolso siguiente;


    /* Enlaza el siguiente validador y lo devuelve
       para poder construir la cadena fluidamente */
    public ValidadorReembolso setSiguiente(
            ValidadorReembolso siguiente) {

        this.siguiente = siguiente;
        return siguiente;
    }


    /* Si la regla falla, la cadena se detiene aqui */
    public final ResultadoValidacion validar(
            Reembolso reembolso,
            LocalDate fechaEvaluacion) {

        ResultadoValidacion resultado =
                evaluar(reembolso, fechaEvaluacion);

        if (resultado != ResultadoValidacion.APROBADO) {
            return resultado;
        }

        if (siguiente != null) {
            return siguiente.validar(
                    reembolso, fechaEvaluacion);
        }

        return ResultadoValidacion.APROBADO;
    }


    protected abstract ResultadoValidacion evaluar(
            Reembolso reembolso,
            LocalDate fechaEvaluacion);
}


class ValidadorComprobante extends ValidadorReembolso {

    @Override
    protected ResultadoValidacion evaluar(
            Reembolso reembolso,
            LocalDate fechaEvaluacion) {

        if (!reembolso.tieneComprobante()) {
            return ResultadoValidacion.SIN_COMPROBANTE;
        }
        return ResultadoValidacion.APROBADO;
    }
}


class ValidadorPeriodo extends ValidadorReembolso {

    private static final long DIAS_MAXIMOS = 30;

    @Override
    protected ResultadoValidacion evaluar(
            Reembolso reembolso,
            LocalDate fechaEvaluacion) {

        long dias = ChronoUnit.DAYS.between(
                reembolso.getFechaGasto(),
                fechaEvaluacion);

        if (dias > DIAS_MAXIMOS) {
            return ResultadoValidacion.FUERA_DE_PERIODO;
        }
        return ResultadoValidacion.APROBADO;
    }
}


class ValidadorLimite extends ValidadorReembolso {

    @Override
    protected ResultadoValidacion evaluar(
            Reembolso reembolso,
            LocalDate fechaEvaluacion) {

        if (reembolso.getMonto()
                > reembolso.getLimitePermitido()) {
            return ResultadoValidacion.EXCEDE_LIMITE;
        }
        return ResultadoValidacion.APROBADO;
    }
}


class ValidadorGerencia extends ValidadorReembolso {

    private static final double MONTO_AUTORIZACION = 2000;

    @Override
    protected ResultadoValidacion evaluar(
            Reembolso reembolso,
            LocalDate fechaEvaluacion) {

        if (reembolso.getMonto() > MONTO_AUTORIZACION
                && !reembolso.estaAutorizadoGerente()) {
            return ResultadoValidacion.REQUIERE_AUTORIZACION;
        }
        return ResultadoValidacion.APROBADO;
    }
}


/* =====================================================
   6. METODO PRINCIPAL DEL RETO
   ===================================================== */

class Result {

    public static ReembolsoOutputDTO procesarReembolso(
            ReembolsoInputDTO input) {

        /* 1. Factory Method: crear el Reembolso correcto */
        Map<TipoReembolso, RegistroReembolso> registros =
                new EnumMap<TipoReembolso, RegistroReembolso>(
                        TipoReembolso.class);

        registros.put(TipoReembolso.ALIMENTOS,
                new RegistroAlimentos());
        registros.put(TipoReembolso.TRANSPORTE,
                new RegistroTransporte());
        registros.put(TipoReembolso.HOSPEDAJE,
                new RegistroHospedaje());

        Reembolso reembolso =
                registros.get(input.getTipo())
                        .crearReembolso(input);


        /* 2. Construir la cadena de validadores */
        ValidadorReembolso primero =
                new ValidadorComprobante();

        primero.setSiguiente(new ValidadorPeriodo())
                .setSiguiente(new ValidadorLimite())
                .setSiguiente(new ValidadorGerencia());


        /* 3 y 4. Enviar al primer handler y obtener resultado */
        ResultadoValidacion resultado =
                primero.validar(
                        reembolso,
                        input.getFechaEvaluacion());


        /* 5. Regresar el DTO de salida */
        return new ReembolsoOutputDTO(
                reembolso.getFolio(),
                input.getTipo(),
                resultado);
    }
}


public class Solution {

    public static void main(String[] args)
            throws Exception {

        BufferedReader br =
                new BufferedReader(
                        new InputStreamReader(System.in));


        String lineaFecha =
                br.readLine();

        LocalDate fechaEvaluacion =
                LocalDate.parse(
                        lineaFecha.trim()
                );


        String lineaSolicitud =
                br.readLine();

        String[] datos =
                lineaSolicitud.split("\\|");


        TipoReembolso tipo =
                TipoReembolso.valueOf(
                        datos[0].trim()
                );

        String folio =
                datos[1].trim();

        String empleado =
                datos[2].trim();

        double monto =
                Double.parseDouble(
                        datos[3].trim()
                );

        LocalDate fechaGasto =
                LocalDate.parse(
                        datos[4].trim()
                );

        boolean tieneComprobante =
                Boolean.parseBoolean(
                        datos[5].trim()
                );

        boolean autorizadoGerente =
                Boolean.parseBoolean(
                        datos[6].trim()
                );


        ReembolsoInputDTO input =
                new ReembolsoInputDTO(
                        tipo,
                        folio,
                        empleado,
                        monto,
                        fechaGasto,
                        tieneComprobante,
                        autorizadoGerente,
                        fechaEvaluacion
                );


        ReembolsoOutputDTO output =
                Result.procesarReembolso(input);


        System.out.println(
                "REEMBOLSO "
                + output.getFolio()
        );

        System.out.println(
                "TIPO "
                + output.getTipo()
        );

        System.out.println(
                "RESULTADO "
                + output.getResultado()
        );
    }
}
