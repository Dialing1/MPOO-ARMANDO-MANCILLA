public class BattleBot {
    public static void main(String[] args) {
        Random random = new Random();

        // 1. Creación de tres robots 
        InfoPropietario p1 = new InfoPropietario("Ana Gómez", "GOMA900101MDF");
        InfoPropietario p2 = new InfoPropietario("Carlos Ruíz", "RUCC880512HDF");
        InfoPropietario p3 = new InfoPropietario("Lucía Torres", "TORL950320MDF");

        Bateria b1 = new Bateria("Litio-Ion", 2025, 100.0);
        Bateria b2 = new Bateria("Polímero de Litio", 2026, 95.0);
        Bateria b3 = new Bateria("Grafeno", 2026, 90.0);

        Robot robot1 = new Robot("Viper", p1, b1);
        Robot robot2 = new Robot("Titan", p2, b2);
        Robot robot3 = new Robot("Viper", p3, b3); // Se llama igual que robot1 para demostrar identidad por UUID

        // 2. Conteo de robots registrados 
        System.out.println("==================================================");
        System.out.println("TOTAL DE ROBOTS PARTICIPANTES: " + Robot.getTotalRobots());
        System.out.println("==================================================\n");

        // 3. Estado antes de la batalla 
        System.out.println("--- ESTADO INICIAL DE LOS ROBOTS ---");
        System.out.println(robot1);
        System.out.println(robot2);
        System.out.println(robot3);
        System.out.println();

        // 4. Simulación de batalla usando valores aleatorios 
        System.out.println("--- ¡INICIA LA BATALLA! ---");

        // Acción Robot 1: velocidad aleatoria entre 2.0 y 10.0
        double velAleatoria1 = 2.0 + random.nextDouble() * 8.0;
        robot1.acelerar(velAleatoria1);
        robot1.desplazar(random.nextInt(10) + 1);

        // Acción Robot 2: velocidad aleatoria y daño recibido aleatorio (0 a 30)
        double velAleatoria2 = 2.0 + random.nextDouble() * 8.0;
        robot2.acelerar(velAleatoria2);
        robot2.desplazar(random.nextInt(10) + 1);
        int impactoAleatorio = random.nextInt(31);
        robot2.recibirAtaque(impactoAleatorio);

        // Acción Robot 3
        robot3.acelerar(2.0);
        robot3.recibirAtaque(random.nextInt(20));

        // 5. Estado después de la batalla 
        System.out.println("\n--- ESTADO FINAL DE LOS ROBOTS ---");
        System.out.println(robot1 + " -> Puntaje: " + String.format("%.2f", robot1.calcularPuntajeCombate()));
        System.out.println(robot2 + " -> Puntaje: " + String.format("%.2f", robot2.calcularPuntajeCombate()));
        System.out.println(robot3 + " -> Puntaje: " + String.format("%.2f", robot3.calcularPuntajeCombate()));
        System.out.println();

        // 6. Experimentación con referencias e igualdad 
        System.out.println("--- EXPERIMENTO DE REFERENCIAS E IGUALDAD ---");
        Robot robotFavorito = robot1; // Nueva referencia al mismo objeto en memoria

        System.out.println("¿robotFavorito es igual a robot1 (equals)? " + robotFavorito.equals(robot1));
        System.out.println("¿robot1 es igual a robot3 aunque compartan el nombre 'Viper'? " + robot1.equals(robot3));

        System.out.println("\nModificando velocidad a través de 'robotFavorito'...");
        robotFavorito.acelerar(2.0);

        System.out.println("Consultando la velocidad directamente desde 'robot1':");
        System.out.println("Velocidad de robot1: " + robot1.getVelocidad() + " m/s");
    }
}
