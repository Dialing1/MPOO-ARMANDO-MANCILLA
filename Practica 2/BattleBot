
import java.util.Objects;
import java.util.Random;
import java.util.UUID;

// ------------------------------------------------------------------
// Clases compuestas 
// ------------------------------------------------------------------

class InfoPropietario {
    private String nombre;
    private String curp;

    public InfoPropietario(String nombre, String curp) {
        this.nombre = nombre;
        this.curp = curp;
    }

    public String getNombre() {
        return nombre;
    }

    public String getCurp() {
        return curp;
    }

    @Override
    public String toString() {
        return nombre + " (CURP: " + curp + ")";
    }
}

class Bateria {
    private String tipo;
    private int Fabricante;
    private double nivelPorcentaje; // 0.0 a 100.0

    public Bateria(String tipo, int Fabricante, double nivelPorcentaje) {
        this.tipo = tipo;
        this.Fabricante = Fabricante;
        this.nivelPorcentaje = Math.min(100.0, Math.max(0.0, nivelPorcentaje));
    }

    public String getTipo() {
        return tipo;
    }

    public int getFabricante() {
        return Fabricante;
    }

    public double getNivelPorcentaje() {
        return nivelPorcentaje;
    }

    public void consumir(double cantidad) {
        this.nivelPorcentaje = Math.max(0.0, this.nivelPorcentaje - cantidad);
    }

    public void recargar(double cantidad) {
        this.nivelPorcentaje = Math.min(100.0, this.nivelPorcentaje + cantidad);
    }

    @Override
    public String toString() {
        return String.format("%.1f%% (%s, %d)", nivelPorcentaje, tipo, Fabricante);
    }
}

// ------------------------------------------------------------------
// Clase principal del Robot 
// ------------------------------------------------------------------

class Robot {
    // Contador compartido por todas las instancias (Requerimiento 9)
    private static int totalRobots = 0;

    // Atributos de instancia
    private final UUID id; // Identidad única por UUID (Requerimiento 3)
    private String nombre;
    private double velocidad;
    private double distanciaRecorrida;
    private int puntosDanioRecibidos;

    // Composición (Requerimiento 4)
    private InfoPropietario propietario;
    private Bateria bateria;

    // Constructor (Requerimiento 5 y 9)
    public Robot(String nombre, InfoPropietario propietario, Bateria bateria) {
        this.id = UUID.randomUUID(); // Asignación automática de UUID
        this.nombre = nombre;
        this.propietario = propietario;
        this.bateria = bateria;
        this.velocidad = 0.0;
        this.distanciaRecorrida = 0.0;
        this.puntosDanioRecibidos = 0;

        // Incremento del contador compartido
        Robot.totalRobots++;
    }

    // Método estático para consultar el total de robots creados
    public static int getTotalRobots() {
        return totalRobots;
    }

    // Getters
    public UUID getId() {
        return id;
    }

    public String getNombre() {
        return nombre;
    }

    public double getVelocidad() {
        return velocidad;
    }

    public double getDistanciaRecorrida() {
        return distanciaRecorrida;
    }

    public int getPuntosDanioRecibidos() {
        return puntosDanioRecibidos;
    }

    public InfoPropietario getPropietario() {
        return propietario;
    }

    public Bateria getBateria() {
        return bateria;
    }

    // --- Métodos de Comportamiento (Requerimiento 6) ---

    // 1. Recibe parámetro y modifica estado
    public void acelerar(double incrementoVelocidad) {
        if (bateria.getNivelPorcentaje() > 5.0) {
            this.velocidad += incrementoVelocidad;
            this.bateria.consumir(incrementoVelocidad * 0.2);
        } else {
            this.velocidad = 0.0;
        }
    }

    // 2. Recibe parámetro y modifica estado
    public void desplazar(double tiempoSegundos) {
        if (this.velocidad > 0 && bateria.getNivelPorcentaje() > 0) {
            double avance = this.velocidad * tiempoSegundos;
            this.distanciaRecorrida += avance;
            this.bateria.consumir(avance * 0.1);
        }
    }

    // 3. Recibe parámetro y modifica estado
    public void recibirAtaque(int fuerzaImpacto) {
        this.puntosDanioRecibidos += fuerzaImpacto;
        this.bateria.consumir(fuerzaImpacto * 0.5);
    }

    // 4. Retorna un valor calculado
    public double calcularPuntajeCombate() {
        double factorBateria = bateria.getNivelPorcentaje() * 1.5;
        double factorAvance = distanciaRecorrida * 2.0;
        double penalizacionDanio = puntosDanioRecibidos * 3.0;

        return Math.max(0.0, (factorBateria + factorAvance) - penalizacionDanio);
    }

    // Sobrescritura de datos

    @Override
    public String toString() {
        return String.format(
            "Robot [ID: %s | Nombre: %s | Propietario: %s | Batería: %s | Vel: %.1f m/s | Dist: %.1f m | Daño: %d pts]",
            id, nombre, propietario.getNombre(), bateria, velocidad, distanciaRecorrida, puntosDanioRecibidos
        );
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (obj == null || getClass() != obj.getClass()) return false;
        Robot robot = (Robot) obj;
        return Objects.equals(id, robot.id);
    }

    @Override
    public int hashCode() {
        return Objects.hash(id);
    }
}

